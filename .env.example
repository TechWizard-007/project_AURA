# Video configuration
# You can override AURA_INPUT_VIDEO at runtime:
# uv run python main.py --video "path/to/your_video.mp4"
AURA_INPUT_VIDEO=data/raw_videos/example.mp4
AURA_OUTPUT_DIR=data/processed/v1
AURA_CHUNK_DURATION=10

# Whisper transcription
# If omitted, the code uses the default Whisper cache location.
# AURA_WHISPER_MODEL_PATH=C:/Users/YOUR_USERNAME/.cache/whisper/large-v3-turbo.pt
AURA_WHISPER_DEVICE=cuda
AURA_WHISPER_BEAM_SIZE=5
# Leave blank for automatic language detection
AURA_WHISPER_LANGUAGE=

# Ollama
AURA_OLLAMA_BASE_URL=http://localhost:11434
AURA_VISION_MODEL=qwen3-vl:8b-instruct
AURA_VISION_TIMEOUT=300

# Visual analysis
AURA_FRAME_GROUP_SIZE=5
AURA_ENABLE_TEMPORAL_ANALYSIS=true

# BGE-M3 embeddings
AURA_EMBEDDING_MODEL=bge-m3:latest
AURA_EMBEDDING_DIMENSIONS=1024
AURA_EMBEDDING_TIMEOUT=300

# ChromaDB
AURA_VECTOR_DB_DIR=data/vector_db
AURA_VISUAL_COLLECTION=aura_visual
AURA_AUDIO_COLLECTION=aura_audio
